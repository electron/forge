{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "node", "promise", "vitest", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "node": true,
    "es2021": true
  },
  "globals": {
    "NodeJS": "readonly"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "args": "after-used",
        "argsIgnorePattern": "^_",
        "ignoreRestSiblings": true,
        "vars": "all"
      }
    ],
    "no-unused-expressions": "warn",
    "sort-imports": [
      "error",
      {
        "ignoreDeclarationSort": true,
        "allowSeparatedGroups": true,
        "ignoreCase": true
      }
    ],
    "import/no-named-as-default": "error",
    "typescript/no-explicit-any": "warn",
    "typescript/only-throw-error": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-floating-promises": "off",
    "typescript/unbound-method": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/no-duplicate-type-constituents": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/no-misused-spread": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/expect-expect": "off",
    "vitest/warn-todo": "off",
    "vitest/require-to-throw-message": "off",
    "vitest/no-conditional-tests": "off",
    "vitest/no-conditional-expect": "off",
    "vitest/no-standalone-expect": "off"
  },
  "overrides": [
    {
      "files": ["**/*.ts"],
      "rules": {
        "no-undef": "off"
      }
    },
    {
      "files": ["**/*.cjs", "**/*.js", "**/*.mjs"],
      "rules": {
        "typescript/no-require-imports": "off"
      }
    },
    {
      "files": [
        "packages/*/*/spec/**/*.spec.ts",
        "packages/*/*/spec/fixture/**/*.ts"
      ],
      "rules": {
        "import/no-dynamic-require": "off",
        "node/global-require": "off"
      }
    },
    {
      "files": [
        "packages/api/core/spec/**/*.ts",
        "packages/maker/*/src/Maker*.ts"
      ],
      "rules": {
        "typescript/no-require-imports": "off"
      }
    },
    {
      "files": ["packages/plugin/webpack/spec/fixtures/**/*.js"],
      "rules": {
        "no-undef": "off"
      }
    },
    {
      "files": ["packages/utils/web-multi-logger/static/*.js"],
      "env": {
        "browser": true,
        "node": false
      }
    }
  ],
  "ignorePatterns": [
    "dist",
    "docs/",
    "coverage",
    "node_modules",
    "*.d.ts",
    "packages/*/*/doc",
    "packages/*/*/index.ts",
    "packages/**/bad.js",
    "tmpl",
    "packages/api/core/helper/dynamic-import.js",
    "packages/api/core/spec/fixture/api-tester/",
    "tools/doc-plugin"
  ]
}
